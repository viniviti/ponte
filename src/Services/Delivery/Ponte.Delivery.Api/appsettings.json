{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeliveryDb": "Host=localhost;Port=5432;Database=ponte_delivery;Username=ponte;Password=ponte;Maximum Pool Size=200"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://ponte:ponte@localhost:5672/",
    "ClientName": "ponte-delivery",
    "PrefetchCount": 64,
    "ConsumerConcurrency": 32
  },
  "Outbox": {
    "PollingInterval": "00:00:00.200",
    "BatchSize": 500
  },
  "Webhooks": {
    "Timeout": "00:00:10",
    "AllowPrivateNetworks": false,
    "MaxConnectionsPerServer": 64
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "BreakDuration": "00:00:30"
  }
}
