{
  "Management": {
    "AllowInsecureEndpointUrls": true
  },
  "Seed": {
    "Enabled": true,
    "Endpoints": [
      {
        "Url": "http://localhost:5199/webhooks/pedidos?failRate=0.15&latencyMs=120",
        "Description": "ERP de pedidos (instavel as vezes)",
        "EventTypes": [ "order.*" ],
        "MaxConcurrency": 10
      },
      {
        "Url": "http://localhost:5199/webhooks/financeiro?failRate=0.6&latencyMs=600",
        "Description": "Sistema financeiro legado (lento e falhando)",
        "EventTypes": [ "invoice.#", "order.paid" ],
        "MaxConcurrency": 3
      },
      {
        "Url": "http://localhost:5199/webhooks/data-lake",
        "Description": "Data lake: recebe tudo",
        "EventTypes": [ "#" ],
        "MaxConcurrency": 20
      }
    ]
  }
}
